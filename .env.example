# API
DEPLOYMENT_PROFILE=development
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/emr_core
API_TOKEN=dev-token
AUTH_LOGIN_CODE=dev-login-code
AUTH_SESSION_SECRET=dev-session-secret-change-me
AUTH_SESSION_TTL_MINUTES=480
AUTH_OIDC_ENABLED=false
# AUTH_OIDC_ISSUER=https://id.example.test
# AUTH_OIDC_AUDIENCE=emr-core
# AUTH_OIDC_HS256_SECRET=change-me-32-plus-characters
# AUTH_OIDC_SUBJECT_CLAIM=sub
PORT=3000

# Frontend dev proxy
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
API_BASE_URL=http://127.0.0.1:3000

# File storage: local driver
FILE_STORAGE_DRIVER=local
FILE_STORAGE_DIR=/tmp/emr-core-file-assets
FILE_STORAGE_MAX_BYTES=5242880
FILE_STORAGE_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp,application/pdf

# File storage: S3/MinIO driver
# FILE_STORAGE_DRIVER=s3
# FILE_STORAGE_S3_ENDPOINT=http://127.0.0.1:9000
# FILE_STORAGE_S3_BUCKET=emr-core-file-assets
# FILE_STORAGE_S3_REGION=us-east-1
# FILE_STORAGE_S3_ACCESS_KEY_ID=change-me
# FILE_STORAGE_S3_SECRET_ACCESS_KEY=change-me
# FILE_STORAGE_S3_FORCE_PATH_STYLE=true
